{
  "name": "volkino",
  "version": "0.9.2",
  "private": true,
  "description": "A remote-friendly webOS torrent search and TorrServer player",
  "scripts": {
    "start": "node server/index.js",
    "test": "npm run build:test-models && node --test test/*.test.js",
    "build:test-models": "tsc --noEmit false --outDir work/test-models --module Node16 --moduleResolution Node16 --noCheck",
    "build": "npm run build:ui && node scripts/package.mjs",
    "check": "node --check server/index.js && node --check server/core.js && node --check server/downloads.js && node --check server/filmix.js && node --check server/filmix-web.js && node --check server/local-torrserver.js && tsc --noEmit && npm run format:check",
    "format": "biome format --write src",
    "format:check": "biome format src",
    "prestart": "npm run build:ui",
    "build:ui": "vite build",
    "test:ui": "npm run build:ui && playwright test",
    "dev": "vite",
    "dev:mock": "vite",
    "build:android": "npm run build:ui && node scripts/android.mjs",
    "build:android:release": "npm run build:ui && node scripts/android.mjs --release"
  },
  "engines": {
    "node": ">=8.12"
  },
  "license": "MIT",
  "dependencies": {
    "core-js": "^3.51.0",
    "mobx": "^6.16.1",
    "mobx-solid": "^0.3.1",
    "mobx-view-model": "^11.0.1",
    "mobx-view-model-solid": "^0.0.3",
    "solid-js": "^1.9.18"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@playwright/test": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.15"
  }
}
